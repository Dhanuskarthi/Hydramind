# ---- Server ----
HOST=0.0.0.0
PORT=8000

# ---- Grid ----
GRID_SIZE_METERS=150
DEFAULT_DISTRICT=Chennai, India

# ---- API keys (all free tiers) ----
# https://portal.opentopography.org  (free signup)
OPENTOPOGRAPHY_API_KEY=

# https://www.sentinel-hub.com (free tier, optional, only needed for Sentinel-1 flood-extent layer)
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=

# ---- CORS ----
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
